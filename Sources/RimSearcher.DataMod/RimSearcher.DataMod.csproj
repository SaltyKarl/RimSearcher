<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>Latest</LangVersion>
		<Version>3.2.0</Version>
		<Nullable>enable</Nullable>
		<Deterministic>true</Deterministic>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<OutputPath>..\..\RimSearcher_DataMod/Assemblies</OutputPath>
		<NativeOutputPath Condition="'$(NativeOutputPath)' == ''">..\..\RimSearcher_DataMod\Native\</NativeOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
		<PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.*" />
		<PackageReference Include="SQLitePCLRaw.core" Version="2.1.*" />
		<PackageReference Include="SQLitePCLRaw.provider.dynamic_cdecl" Version="2.1.*" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.*" ExcludeAssets="all" GeneratePathProperty="true" />
	</ItemGroup>

	<Target Name="CopySqliteNative" AfterTargets="Build">
		<ItemGroup>
			<NativeRuntime Include="$(PkgSQLitePCLRaw_lib_e_sqlite3)\runtimes\win-x64\native\e_sqlite3.dll" />
			<NativeRuntime Include="$(PkgSQLitePCLRaw_lib_e_sqlite3)\runtimes\linux-x64\native\libe_sqlite3.so" />
			<NativeRuntime Include="$(PkgSQLitePCLRaw_lib_e_sqlite3)\runtimes\osx-x64\native\libe_sqlite3.dylib" />
		</ItemGroup>
		<Copy SourceFiles="@(NativeRuntime)"
			DestinationFolder="$(NativeOutputPath)"
			SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(PkgSQLitePCLRaw_lib_e_sqlite3)\runtimes\osx-arm64\native\libe_sqlite3.dylib"
			DestinationFiles="$(NativeOutputPath)\libe_sqlite3.arm64.dylib"
			SkipUnchangedFiles="true" />
	</Target>

	<Target Name="DeployMod" AfterTargets="Build">
		<ItemGroup>
			<DeployAsm Include="$(OutDir)RimSearcher.DataMod.dll" />
			<DeployAsm Include="$(OutDir)RimSearcher.DataMod.pdb" />
			<!-- Runtime dependencies required by the mod (explicitly deployed, not accidental CopyLocal) -->
			<DeployAsm Include="$(OutDir)Microsoft.Data.Sqlite.dll" />
			<DeployAsm Include="$(OutDir)SQLitePCLRaw.core.dll" />
			<DeployAsm Include="$(OutDir)SQLitePCLRaw.provider.dynamic_cdecl.dll" />
			<DeployAsm Include="$(OutDir)System.Buffers.dll" />
			<DeployAsm Include="$(OutDir)System.Memory.dll" />
			<DeployAsm Include="$(OutDir)System.Numerics.Vectors.dll" />
			<DeployAsm Include="$(OutDir)System.Runtime.CompilerServices.Unsafe.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(DeployAsm)"
			DestinationFolder="..\..\RimSearcher_DataMod\Assemblies"
			SkipUnchangedFiles="true" />
	</Target>

</Project>